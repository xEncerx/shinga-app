  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"read_mode\" TEXT NOT NULL, \"title_button_style\" TEXT NOT NULL, \"theme_mode\" TEXT NOT NULL, \"color_scheme\" TEXT NOT NULL, \"language\" TEXT NOT NULL, \"is_ad_blocker_enabled\" INTEGER NOT NULL CHECK (\"is_ad_blocker_enabled\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "ad_blocker_filter_subscriptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ad_blocker_filter_subscriptions\" (\"settings_id\" INTEGER NOT NULL REFERENCES app_settings (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"url\" TEXT NOT NULL, PRIMARY KEY (\"settings_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "current_session",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"current_session\" (\"id\" INTEGER NOT NULL, \"user_id\" INTEGER NOT NULL, \"username\" TEXT NOT NULL, \"email\" TEXT NOT NULL, \"avatar_path\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"description\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "title_search_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"title_search_history\" (\"query\" TEXT NOT NULL, \"searched_at\" TEXT NOT NULL, PRIMARY KEY (\"query\"));"
        }
      ]
    },
    {
      "name": "title_search_history_searched_at",
